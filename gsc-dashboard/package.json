{
  "name": "gsc-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Google Search Console analytics dashboard with US-default keyword/query reporting and 7-day impression-drop alerts.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/src/index.js",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "tsc -p client/tsconfig.json && vite build --config client/vite.config.ts",
    "start": "node server/src/index.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "googleapis": "^144.0.0",
    "lucide-react": "^0.555.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
