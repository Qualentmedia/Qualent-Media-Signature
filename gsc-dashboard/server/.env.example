# ─────────────────────────────────────────────────────────────
# GSC Dashboard — server configuration
# Copy this file to ".env" and fill in the values to enable LIVE
# Google Search Console data. Without these, the app runs in DEMO
# mode using realistic mock data (no setup required).
# ─────────────────────────────────────────────────────────────

# Port the API server listens on.
PORT=4000

# Public URL of the frontend (used for OAuth redirects & CORS).
CLIENT_URL=http://localhost:3000

# Google Cloud OAuth 2.0 credentials.
# Create them at: https://console.cloud.google.com/apis/credentials
# Enable the "Google Search Console API" for the project, and add
# the redirect URI below to the OAuth client's "Authorized redirect URIs".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Secret used to sign the session cookie. Use any long random string.
SESSION_SECRET=change-me-to-a-long-random-string

# Set to "true" to force demo data even when Google credentials exist.
FORCE_DEMO=false
